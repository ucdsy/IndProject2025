{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdns.local/schemas/multi_intent_eval_sample.schema.json",
  "title": "MultiIntentEvalSample",
  "type": "object",
  "required": [
    "id",
    "family_id",
    "dataset_version",
    "namespace_version",
    "query",
    "gold_intent_fqdns",
    "intent_count",
    "intent_count_bucket",
    "domain_mix",
    "context",
    "intent_notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^multi_intent_eval_v1_[0-9]{6}$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^multi_intent_eval_v1_[a-z0-9_]+_[0-9]{6}_f01$"
    },
    "dataset_version": {
      "type": "string",
      "const": "multi_intent_eval_v1_20260426"
    },
    "namespace_version": {
      "type": "string",
      "const": "ns_v1_20260311"
    },
    "query": {
      "type": "string",
      "minLength": 8
    },
    "gold_intent_fqdns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z0-9-]+\\.){1,3}cn$"
      }
    },
    "intent_count": {
      "type": "integer",
      "minimum": 1
    },
    "intent_count_bucket": {
      "type": "string",
      "enum": [
        "single",
        "double",
        "triple",
        "four_plus"
      ]
    },
    "domain_mix": {
      "type": "string",
      "enum": [
        "travel_life",
        "enterprise_ops",
        "finance_commerce",
        "health_education",
        "governance",
        "cross_domain"
      ]
    },
    "context": {
      "type": "object"
    },
    "intent_notes": {
      "type": "string",
      "minLength": 8
    }
  },
  "additionalProperties": false
}
